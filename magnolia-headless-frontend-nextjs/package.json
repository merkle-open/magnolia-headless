{
	"name": "@merkle-open/magnolia-headless-frontend-nextjs",
	"version": "0.0.27-SNAPSHOT",
	"description": "Magnolia headless frontend nextJs",
	"license": "MIT",
	"author": "Merkle Inc.",
	"private": false,
	"main": "index.ts",
	"module": "index.ts",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"files": [
		"README.md",
		"index.ts",
		"src",
		"src/**/_README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/merkle-open/magnolia-headless.git"
	},
	"scripts": {
		"generate-oss-magnoliaConfig": "npx tsx src/scripts/generate-magnolia-config.ts src/templates src/templates",
		"build": "tsc --build",
		"clean": "tsc --build --clean",
		"format": "prettier --write src/**",
		"lint": "eslint src/**",
		"prepare": "cd .. && husky magnolia-headless-frontend-nextjs/.husky"
	},
	"dependencies": {
		"@magnolia/react-editor": "3.0.0"
	},
	"peerDependencies": {
		"next": "^16.4",
		"react": "^19.3",
		"react-dom": "^19.3",
		"reflect-metadata": "^0.2",
		"tsyringe": "^4.10"
	},
	"devDependencies": {
		"@eslint-react/eslint-plugin": "^5.30.2",
		"@types/node": "^26.6.6",
		"@types/react": "19.3.0",
		"@typescript-eslint/eslint-plugin": "^8.72.2",
		"@typescript-eslint/parser": "^8.72.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"husky": "^9.1.7",
		"jiti": "^2.7.0",
		"lint-staged": "^17.6.0",
		"prettier": "^3.10.1",
		"tsx": "^4.23.15",
		"typescript-eslint": "^8.72.2"
	},
	"lint-staged": {
		"*.{js,jsx,ts,tsx,md,mdx,html,css}": "npm run format"
	}
}
